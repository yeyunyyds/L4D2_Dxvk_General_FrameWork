#version 450
layout(local_size_x=8,local_size_y=8) in;
layout(set=0,binding=0) uniform sampler2D currentDepth;
layout(set=0,binding=1) uniform sampler2D previousDepth;
layout(set=0,binding=2) uniform sampler2D currentNear;
layout(set=0,binding=3) uniform sampler2D previousNear;
layout(set=0,binding=4) uniform sampler2D currentUi;
layout(set=0,binding=5) uniform sampler2D previousUi;
layout(set=0,binding=6) uniform sampler2D currentFinal;
layout(set=0,binding=7) uniform sampler2D previousFinal;
layout(set=0,binding=8,rgba8) writeonly uniform image2D generated;
layout(set=0,binding=9,std140) uniform Parameters { vec4 rows[24];uvec4 flags;vec4 thresholds; } p;
layout(set=0,binding=10,rgba8) writeonly uniform image2D classification;
layout(set=0,binding=11) uniform sampler2D currentNearBefore;
layout(set=0,binding=12) uniform sampler2D currentNearAfter;
layout(set=0,binding=13) uniform sampler2D previousNearBefore;
layout(set=0,binding=14) uniform sampler2D previousNearAfter;
vec4 project(uint m,vec4 v) { return vec4(dot(p.rows[m*4],v),dot(p.rows[m*4+1],v),dot(p.rows[m*4+2],v),dot(p.rows[m*4+3],v)); }
ivec2 pixel(vec2 v) { return ivec2(floor(v+0.5)); }
bool inside(vec2 v) { ivec2 x=pixel(v);return all(greaterThanEqual(x,ivec2(0)))&&all(lessThan(x,ivec2(p.flags.xy))); }
vec4 sampleAt(sampler2D s,vec2 v) { return texelFetch(s,clamp(pixel(v),ivec2(0),ivec2(p.flags.xy)-1),0); }
bool locate(uint matrix,vec4 clip,out vec2 xy,out float z) {
 vec4 v=project(matrix,clip);
 if(any(isnan(v))||any(isinf(v))||v.w<=1e-8)return false;
 v.xyz/=v.w;xy=vec2((v.x+1)*float(p.flags.x)/2,(1-v.y)*float(p.flags.y)/2);z=v.z;
 return inside(xy);
}
uint foregroundSources(vec2 xy,bool previous) {
 uint sources=0u;
 uint f=previous?p.flags.w:p.flags.z;
 if((f&8u)!=0u) {
  vec3 a=previous?sampleAt(previousNearBefore,xy).rgb:sampleAt(currentNearBefore,xy).rgb;
  vec3 b=previous?sampleAt(previousNearAfter,xy).rgb:sampleAt(currentNearAfter,xy).rgb;
  // Same-format before/after HDR snapshots: detect the actual colour draw,
  // including viewmodels with disabled depth writes and alpha materials.
  if(any(greaterThan(abs(a-b),vec3(0.00001))))sources|=4u;
 }
 if((f&1u)!=0u) {
  float d=previous?sampleAt(previousNear,xy).r:sampleAt(currentNear,xy).r;
  if(d>=0&&d<=0.10001)sources|=1u;
 }
 if((f&2u)!=0u) {
  vec3 finalColor=previous?sampleAt(previousFinal,xy).rgb:sampleAt(currentFinal,xy).rgb;
  vec3 before=previous?sampleAt(previousUi,xy).rgb:sampleAt(currentUi,xy).rgb;
  if(any(greaterThan(abs(finalColor-before),vec3(0.5/255))))sources|=2u;
 }
 return sources;
}
bool foreground(vec2 xy,bool previous) {
 uint f=previous?p.flags.w:p.flags.z;
 uint sources=foregroundSources(xy,previous);
 // Complete before/after colour is authoritative. A cleared near depth
 // buffer can classify the entire scene as a viewmodel. Keep depth diagnostic
 // counts, but do not OR that raw range into a valid colour mask.
 return (sources & (((f&8u)!=0u)?6u:3u))!=0u;
}
bool foregroundEdge(vec2 xy) {
 if(foreground(xy,false))return true;
 const vec2 offsets[4]=vec2[](vec2(1,0),vec2(-1,0),vec2(0,1),vec2(0,-1));
 for(int i=0;i<4;i++)if(foreground(xy+offsets[i],false))return true;
 return false;
}
bool temporalChange(vec2 cx,vec2 px) {
 // Conservative rejection, not object motion estimation. Preserve the current
 // screen pixel instead of moving a changed object with camera-only flow.
 if(any(greaterThan(abs(sampleAt(currentFinal,cx).rgb-sampleAt(previousFinal,px).rgb),vec3(0.12))))return true;
 const vec2 offsets[4]=vec2[](vec2(1,0),vec2(-1,0),vec2(0,1),vec2(0,-1));
 int changed=0;
 for(int i=0;i<4;i++) {
  if(any(greaterThan(abs(sampleAt(currentFinal,cx+offsets[i]).rgb-sampleAt(previousFinal,px+offsets[i]).rgb),vec3(0.12))))changed++;
 }
 return changed>=2;
}
vec4 clipAt(vec2 xy,float z) {
 return vec4(2*xy.x/float(p.flags.x)-1,1-2*xy.y/float(p.flags.y),z,1);
}
float sourceDepth(vec2 xy,bool previous) {
 return previous?sampleAt(previousDepth,xy).r:sampleAt(currentDepth,xy).r;
}
bool sceneDepth(float z){return z>.2&&z<.999999&&!isnan(z)&&!isinf(z);}
bool gatherDepth(vec2 screen,bool previous,out vec2 source,out float midZ) {
 midZ=sourceDepth(screen,previous);if(!sceneDepth(midZ))return false;
 uint fromMid=previous?1u:0u,toMid=previous?5u:2u;float expected;
 for(int i=0;i<3;i++) {
  if(!locate(fromMid,clipAt(screen,midZ),source,expected))return false;
  float actual=sourceDepth(source,previous);if(!sceneDepth(actual))return false;
  vec4 mid=project(toMid,clipAt(source,actual));if(mid.w<=1e-8)return false;
  midZ=mid.z/mid.w;
 }
 if(!locate(fromMid,clipAt(screen,midZ),source,expected))return false;
 return abs(sourceDepth(source,previous)-expected)<=p.thresholds.x&&!foreground(source,previous);
}
vec3 sourceColour(vec2 xy,bool previous) {
 return previous?sampleAt(previousFinal,xy).rgb:sampleAt(currentFinal,xy).rgb;
}
bool cameraOther(vec2 source,bool previous,out vec2 other,out float z) {
 vec4 mid=project(previous?5u:2u,clipAt(source,sourceDepth(source,previous)));
 return locate(previous?0u:1u,mid,other,z);
}
float patchScore(vec2 source,vec2 other,bool previous,float expectedDepth) {
 if(!inside(other+vec2(-2))||!inside(other+vec2(2))||foreground(other,!previous)||
    !sceneDepth(sourceDepth(other,!previous))||abs(sourceDepth(other,!previous)-expectedDepth)>.002)return 1;
 float sum=0;
 for(int y=-2;y<=2;y+=2)for(int x=-2;x<=2;x+=2) {
  vec2 off=vec2(x,y);
  sum+=dot(abs(sourceColour(source+off,previous)-sourceColour(other+off,!previous)),vec3(1.0/27.0));
 }
 return sum;
}
bool matchPatch(vec2 source,bool previous,out vec2 other) {
 if(!inside(source-vec2(2))||!inside(source+vec2(2))||foreground(source,previous))return false;
 vec2 predicted;float expected;
 if(!cameraOther(source,previous,predicted,expected))return false;
 vec3 centre=sourceColour(source,previous);float contrast=0;
 for(int y=-2;y<=2;y+=2)for(int x=-2;x<=2;x+=2)
  contrast+=dot(abs(sourceColour(source+vec2(x,y),previous)-centre),vec3(1.0/27.0));
 if(contrast<.02)return false; // flat/ambiguous surfaces have no trusted motion.
 float best=1,second=1;vec2 bestPoint=predicted;
 for(int y=-8;y<=8;y+=2)for(int x=-8;x<=8;x+=2) {
  vec2 point=predicted+vec2(x,y);float score=patchScore(source,point,previous,expected);
  if(score<best){if(distance(point,bestPoint)>3)second=min(second,best);best=score;bestPoint=point;}
  else if(distance(point,bestPoint)>3)second=min(second,score);
 }
 vec2 coarse=bestPoint;
 for(int y=-1;y<=1;y++)for(int x=-1;x<=1;x++) {
  vec2 point=coarse+vec2(x,y);float score=patchScore(source,point,previous,expected);
  if(score<best){best=score;bestPoint=point;}
 }
 if(best>.025||second-best<.003||distance(bestPoint,predicted)<.75||
    any(greaterThan(abs(bestPoint-predicted),vec2(8))))return false;
 other=bestPoint;return true;
}
bool motionSample(vec2 screen,vec2 seed,bool previous,out vec4 colour,out float midDepth) {
 vec2 a=seed,b,midxy;float mz;
 for(int i=0;i<2;i++) {
  if(!matchPatch(a,previous,b))return false;
  vec2 am,bm;float az,bz;
  if(!locate(previous?5u:2u,clipAt(a,sourceDepth(a,previous)),am,az)||
     !locate(previous?2u:5u,clipAt(b,sourceDepth(b,!previous)),bm,bz))return false;
  midxy=(am+bm)*.5;mz=(az+bz)*.5;
  if(i==0)a+=screen-midxy;
 }
 if(distance(midxy,screen)>1.0)return false;
 vec2 roundtrip;if(!matchPatch(b,!previous,roundtrip)||distance(roundtrip,a)>1.25)return false;
 colour=vec4((sourceColour(a,previous)+sourceColour(b,!previous))*.5,1);
 midDepth=mz;return true;
}

layout(set=0,binding=15,std430) buffer FrameQuality { uint counts[]; } quality;
shared uvec4 groupCounts[64];
shared uvec4 sourceCounts[64];
void main() {
 uint local=gl_LocalInvocationIndex;uvec4 cell=uvec4(0u),sources=uvec4(0u);
 ivec2 xy=ivec2(gl_GlobalInvocationID.xy);
 if(all(lessThan(xy,ivec2(p.flags.xy)))) {
 vec2 screen=vec2(xy);vec4 fallback=sampleAt(currentFinal,screen),result=fallback;vec4 mark=vec4(1,0,0,1);
 vec2 ndc=vec2(2*screen.x/float(p.flags.x)-1,1-2*screen.y/float(p.flags.y));
 if(foregroundEdge(screen)){mark=vec4(1,1,0,1);}
 else {
  float z=texelFetch(currentDepth,xy,0).r;vec2 cx,px;float cz,pz;
  vec2 currentSeed,previousSeed;float currentZ,previousZ;
  bool currentValid=gatherDepth(screen,false,currentSeed,currentZ);
  bool previousValid=gatherDepth(screen,true,previousSeed,previousZ);
  if(z>=0.999999&&!currentValid&&!previousValid) {
   bool c=locate(3u,vec4(ndc,1,1),cx,cz);bool a=locate(4u,vec4(ndc,1,1),px,pz);
   c=c&&sampleAt(currentDepth,cx).r>=0.999999&&!foreground(cx,false);
   a=a&&sampleAt(previousDepth,px).r>=0.999999&&!foreground(px,true);
   if(c){result=sampleAt(currentFinal,cx);if(a)result=(result+sampleAt(previousFinal,px))*0.5;mark=vec4(1,1,1,1);}
  } else {
   bool have=currentValid||previousValid;
   float midZ=currentValid?currentZ:previousZ;
   if(previousValid&&(!currentValid||previousZ<currentZ))midZ=previousZ;
   bool c=false,a=false,currentProjection=false;
   if(have) {
    currentProjection=c=locate(0u,clipAt(screen,midZ),cx,cz);
    c=c&&sceneDepth(sourceDepth(cx,false))&&abs(sourceDepth(cx,false)-cz)<=p.thresholds.x&&!foreground(cx,false);
    a=locate(1u,clipAt(screen,midZ),px,pz);
    a=a&&sceneDepth(sourceDepth(px,true))&&abs(sourceDepth(px,true)-pz)<=p.thresholds.x&&!foreground(px,true);
   }
   bool changed=c&&a&&temporalChange(cx,px);
   bool moved=false;vec4 motionColour;float motionZ;
   if((p.flags.z&16u)!=0u&&(!c||!a||changed||patchScore(cx,px,false,pz)>.01)) {
    if(currentValid)moved=motionSample(screen,currentSeed,false,motionColour,motionZ);
    vec4 oldMotion;float oldZ;
    if(previousValid&&motionSample(screen,previousSeed,true,oldMotion,oldZ)&&(!moved||oldZ<motionZ)) {
     moved=true;motionColour=oldMotion;motionZ=oldZ;
    }
    // A matched object cannot overwrite a closer static surface.
    if(moved&&have&&motionZ>midZ+p.thresholds.x)moved=false;
   }
   if(moved){result=motionColour;mark=vec4(0,0,1,1);}
   else if(c) {
    result=sampleAt(currentFinal,cx);mark=vec4(0,1,1,1);
    if(a) {
     vec4 old=sampleAt(previousFinal,px);
     if(!changed&&all(lessThanEqual(abs(old.rgb-result.rgb),vec3(p.thresholds.y)))){result=(result+old)*.5;mark=vec4(0,1,0,1);}
     else{result=fallback;mark=vec4(1,0,1,1);}
    }
   } else if(a&&currentProjection&&sceneDepth(sourceDepth(cx,false))&&sourceDepth(cx,false)<cz-p.thresholds.x) {
    // Previous-only static geometry is trusted when a closer current surface
    // occludes its projection. A farther current depth can mean a moving or
    // disappearing object; never leave that previous object as a ghost.
    result=sampleAt(previousFinal,px);mark=vec4(1,.5,0,1);
   }
  }

 }
 result.a=1;
 if((p.flags.z&4u)!=0u)result=result.bgra;
 imageStore(generated,xy,result);imageStore(classification,xy,mark);
 uint raw=foregroundSources(screen,false);
 sources=uvec4(uint((raw&4u)!=0u),uint((raw&1u)!=0u),uint((raw&2u)!=0u),uint(mark.r<.5&&mark.g<.5&&mark.b>.5));
 cell.x=1u;
 if((mark.g>.5&&!(mark.r>.5&&mark.b<.5))||(mark.r<.5&&mark.g<.5&&mark.b>.5)||(mark.r>.5&&mark.g>.1&&mark.g<.75&&mark.b<.5))cell.w=1u;
 if(mark.r>.5&&mark.g<.5&&mark.b<.5)cell.y=1u;
 if(mark.r>.5&&mark.g>.5&&mark.b<.5)cell.z=1u;
 }
 groupCounts[local]=cell;sourceCounts[local]=sources;barrier();
 for(uint stride=32u;stride>0u;stride/=2u){if(local<stride){groupCounts[local]+=groupCounts[local+stride];sourceCounts[local]+=sourceCounts[local+stride];}barrier();}
 if(local==0u) {
  uint offset=(gl_WorkGroupID.y*gl_NumWorkGroups.x+gl_WorkGroupID.x)*8u;
  quality.counts[offset]=groupCounts[0].x;quality.counts[offset+1u]=groupCounts[0].y;
  quality.counts[offset+2u]=groupCounts[0].z;quality.counts[offset+3u]=groupCounts[0].w;
  for(uint i=0u;i<4u;i++)quality.counts[offset+4u+i]=sourceCounts[0][i];
 }
}
