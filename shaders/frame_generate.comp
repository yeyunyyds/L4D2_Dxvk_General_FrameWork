#version 450
layout(local_size_x=8,local_size_y=8) in;
layout(set=0,binding=0) uniform sampler2D currentDepth;
layout(set=0,binding=1) uniform sampler2D previousDepth;
layout(set=0,binding=2) uniform sampler2D currentNear;
layout(set=0,binding=3) uniform sampler2D previousNear;
layout(set=0,binding=4) uniform sampler2D currentUi;
layout(set=0,binding=5) uniform sampler2D previousUi;
layout(set=0,binding=6) uniform sampler2D currentFinal;
layout(set=0,binding=7) uniform sampler2D previousFinal;
layout(set=0,binding=8,rgba8) writeonly uniform image2D generated;
layout(set=0,binding=9,std140) uniform Parameters { vec4 rows[20];uvec4 flags;vec4 thresholds; } p;
layout(set=0,binding=10,rgba8) writeonly uniform image2D classification;
layout(set=0,binding=11) uniform sampler2D currentNearBefore;
layout(set=0,binding=12) uniform sampler2D currentNearAfter;
layout(set=0,binding=13) uniform sampler2D previousNearBefore;
layout(set=0,binding=14) uniform sampler2D previousNearAfter;
vec4 project(uint m,vec4 v) { return vec4(dot(p.rows[m*4],v),dot(p.rows[m*4+1],v),dot(p.rows[m*4+2],v),dot(p.rows[m*4+3],v)); }
ivec2 pixel(vec2 v) { return ivec2(floor(v+0.5)); }
bool inside(vec2 v) { ivec2 x=pixel(v);return all(greaterThanEqual(x,ivec2(0)))&&all(lessThan(x,ivec2(p.flags.xy))); }
vec4 sampleAt(sampler2D s,vec2 v) { return texelFetch(s,clamp(pixel(v),ivec2(0),ivec2(p.flags.xy)-1),0); }
bool locate(uint matrix,vec4 clip,out vec2 xy,out float z) {
 vec4 v=project(matrix,clip);
 if(any(isnan(v))||any(isinf(v))||v.w<=1e-8)return false;
 v.xyz/=v.w;xy=vec2((v.x+1)*float(p.flags.x)/2,(1-v.y)*float(p.flags.y)/2);z=v.z;
 return inside(xy);
}
uint foregroundSources(vec2 xy,bool previous) {
 uint sources=0u;
 uint f=previous?p.flags.w:p.flags.z;
 if((f&8u)!=0u) {
  vec3 a=previous?sampleAt(previousNearBefore,xy).rgb:sampleAt(currentNearBefore,xy).rgb;
  vec3 b=previous?sampleAt(previousNearAfter,xy).rgb:sampleAt(currentNearAfter,xy).rgb;
  // Same-format before/after HDR snapshots: detect the actual colour draw,
  // including viewmodels with disabled depth writes and alpha materials.
  if(any(greaterThan(abs(a-b),vec3(0.00001))))sources|=4u;
 }
 if((f&1u)!=0u) {
  float d=previous?sampleAt(previousNear,xy).r:sampleAt(currentNear,xy).r;
  if(d>=0&&d<=0.10001)sources|=1u;
 }
 if((f&2u)!=0u) {
  vec3 finalColor=previous?sampleAt(previousFinal,xy).rgb:sampleAt(currentFinal,xy).rgb;
  vec3 before=previous?sampleAt(previousUi,xy).rgb:sampleAt(currentUi,xy).rgb;
  if(any(greaterThan(abs(finalColor-before),vec3(0.5/255))))sources|=2u;
 }
 return sources;
}
bool foreground(vec2 xy,bool previous) {
 uint f=previous?p.flags.w:p.flags.z;
 uint sources=foregroundSources(xy,previous);
 // Complete before/after colour is authoritative. A cleared near depth
 // buffer can classify the entire scene as a viewmodel. Keep depth diagnostic
 // counts, but do not OR that raw range into a valid colour mask.
 return (sources & (((f&8u)!=0u)?6u:3u))!=0u;
}
bool foregroundEdge(vec2 xy) {
 if(foreground(xy,false))return true;
 const vec2 offsets[4]=vec2[](vec2(1,0),vec2(-1,0),vec2(0,1),vec2(0,-1));
 for(int i=0;i<4;i++)if(foreground(xy+offsets[i],false))return true;
 return false;
}
bool temporalChange(vec2 cx,vec2 px) {
 // Conservative rejection, not object motion estimation. Preserve the current
 // screen pixel instead of moving a changed object with camera-only flow.
 if(any(greaterThan(abs(sampleAt(currentFinal,cx).rgb-sampleAt(previousFinal,px).rgb),vec3(0.12))))return true;
 const vec2 offsets[4]=vec2[](vec2(1,0),vec2(-1,0),vec2(0,1),vec2(0,-1));
 int changed=0;
 for(int i=0;i<4;i++) {
  if(any(greaterThan(abs(sampleAt(currentFinal,cx+offsets[i]).rgb-sampleAt(previousFinal,px+offsets[i]).rgb),vec3(0.12))))changed++;
 }
 return changed>=2;
}
layout(set=0,binding=15,std430) buffer FrameQuality { uint counts[]; } quality;
shared uvec4 groupCounts[64];
shared uvec4 sourceCounts[64];
void main() {
 uint local=gl_LocalInvocationIndex;uvec4 cell=uvec4(0u),sources=uvec4(0u);
 ivec2 xy=ivec2(gl_GlobalInvocationID.xy);
 if(all(lessThan(xy,ivec2(p.flags.xy)))) {
 vec2 screen=vec2(xy);vec4 fallback=sampleAt(currentFinal,screen),result=fallback;vec4 mark=vec4(1,0,0,1);
 vec2 ndc=vec2(2*screen.x/float(p.flags.x)-1,1-2*screen.y/float(p.flags.y));
 if(foregroundEdge(screen)){mark=vec4(1,1,0,1);}
 else {
  float z=texelFetch(currentDepth,xy,0).r;vec2 cx,px;float cz,pz;
  if(z>=0.999999) {
   bool c=locate(3u,vec4(ndc,1,1),cx,cz);bool a=locate(4u,vec4(ndc,1,1),px,pz);
   c=c&&sampleAt(currentDepth,cx).r>=0.999999&&!foreground(cx,false);
   a=a&&sampleAt(previousDepth,px).r>=0.999999&&!foreground(px,true);
   if(c){result=sampleAt(currentFinal,cx);if(a)result=(result+sampleAt(previousFinal,px))*0.5;mark=vec4(1,1,1,1);}
  } else if(z>0.2&&!isnan(z)&&!isinf(z)) {
   float midZ=z;bool c=false;
   for(int i=0;i<3;i++) {
    c=locate(0u,vec4(ndc,midZ,1),cx,cz);if(!c)break;
    float actual=sampleAt(currentDepth,cx).r;if(actual<=0.2||actual>=0.999999){c=false;break;}
    vec2 cndc=vec2(2*cx.x/float(p.flags.x)-1,1-2*cx.y/float(p.flags.y));
    vec4 m=project(2u,vec4(cndc,actual,1));if(m.w<=1e-8){c=false;break;}midZ=m.z/m.w;
   }
   c=c&&locate(0u,vec4(ndc,midZ,1),cx,cz);
   if(c) {
    float actual=sampleAt(currentDepth,cx).r;
    c=actual>0.2&&actual<0.999999&&abs(actual-cz)<=p.thresholds.x&&!foreground(cx,false);
   }
   bool a=locate(1u,vec4(ndc,midZ,1),px,pz);
   if(a){float actual=sampleAt(previousDepth,px).r;a=actual>0.2&&actual<0.999999&&abs(actual-pz)<=p.thresholds.x&&!foreground(px,true);}
   if(c) {
    result=sampleAt(currentFinal,cx);mark=vec4(0,1,1,1);
    if(a) {
     vec4 old=sampleAt(previousFinal,px);
     if(!temporalChange(cx,px)&&all(lessThanEqual(abs(old.rgb-result.rgb),vec3(p.thresholds.y)))){result=(result+old)*0.5;mark=vec4(0,1,0,1);}
     else {result=fallback;mark=vec4(1,0,1,1);}
    }
   }
  }
 }
 result.a=1;
 if((p.flags.z&4u)!=0u)result=result.bgra;
 imageStore(generated,xy,result);imageStore(classification,xy,mark);
 uint raw=foregroundSources(screen,false);
 sources=uvec4(uint((raw&4u)!=0u),uint((raw&1u)!=0u),uint((raw&2u)!=0u),0u);
 cell.x=1u;
 if(mark.g>.5&&!(mark.r>.5&&mark.b<.5))cell.w=1u;
 if(mark.r>.5&&mark.g<.5&&mark.b<.5)cell.y=1u;
 if(mark.r>.5&&mark.g>.5&&mark.b<.5)cell.z=1u;
 }
 groupCounts[local]=cell;sourceCounts[local]=sources;barrier();
 for(uint stride=32u;stride>0u;stride/=2u){if(local<stride){groupCounts[local]+=groupCounts[local+stride];sourceCounts[local]+=sourceCounts[local+stride];}barrier();}
 if(local==0u) {
  uint offset=(gl_WorkGroupID.y*gl_NumWorkGroups.x+gl_WorkGroupID.x)*8u;
  quality.counts[offset]=groupCounts[0].x;quality.counts[offset+1u]=groupCounts[0].y;
  quality.counts[offset+2u]=groupCounts[0].z;quality.counts[offset+3u]=groupCounts[0].w;
  for(uint i=0u;i<4u;i++)quality.counts[offset+4u+i]=sourceCounts[0][i];
 }
}
