+static bool ValidateHostFrameStatsOutput(AsteriaHostFrameStatsV2 *stats)
+{
+    __try
+    {
+        return stats && stats->structSize == sizeof(AsteriaHostFrameStatsV2) &&
+            stats->apiVersion == ASTERIA_HOST_FRAME_API_VERSION_2;
+    }
+    __except (EXCEPTION_EXECUTE_HANDLER)
+    {
+        return false;
+    }
+}
+
+static bool CopyHostFrameStatsOutput(AsteriaHostFrameStatsV2 *stats, const AsteriaHostFrameStatsV2 *result)
+{
+    __try
+    {
+        *stats = *result;
+        return true;
+    }
+    __except (EXCEPTION_EXECUTE_HANDLER)
+    {
+        return false;
+    }
+}
+
+extern "C" int32_t __stdcall AsteriaQueryHostFrameStatsV2(AsteriaHostFrameStatsV2 *stats)
+{
+    if (!ValidateHostFrameStatsOutput(stats)) return -1;
+    AsteriaHostFrameStatsV2 result{sizeof(AsteriaHostFrameStatsV2), ASTERIA_HOST_FRAME_API_VERSION_2};
+    {
+        const std::lock_guard<std::mutex> lock(FgCamera.mutex);
+        result.submitted = FgCamera.hostSubmitted; result.accepted = FgCamera.hostAccepted;
+        result.consumed = FgCamera.hostConsumed; result.rejected = FgCamera.hostRejected;
+        result.staleAtPresent = FgCamera.hostStaleAtPresent; result.latestGeneration = FgCamera.hostGeneration;
+        result.latestFrameId = FgCamera.hostFrameId; result.latestConsumedFrameId = FgCamera.latestConsumedHostFrameId;
+    }
+    return CopyHostFrameStatsOutput(stats, &result) ? 0 : -1;
+}
