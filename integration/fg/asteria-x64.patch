+static bool CopyHostFrameInput(const AsteriaHostFrameV2 *frame, AsteriaHostFrameV2 *outCopy)
+{
+    __try
+    {
+        if (!frame || frame->structSize != sizeof(AsteriaHostFrameV2) ||
+            frame->apiVersion != ASTERIA_HOST_FRAME_API_VERSION_2)
+            return false;
+        *outCopy = *frame;
+        return true;
+    }
+    __except (EXCEPTION_EXECUTE_HANDLER)
+    {
+        return false;
+    }
+}
+
+extern "C" int32_t __stdcall AsteriaSubmitHostFrameV2(const AsteriaHostFrameV2 *frame)
+{
+    AsteriaHostFrameV2 local{};
+    if (!CopyHostFrameInput(frame, &local)) return -1;
