+    FgCamera.fovVerticalRadians = local.cameraVerticalFov;
+    std::memcpy(FgCamera.position, local.cameraPosition, sizeof(FgCamera.position));
+    std::memcpy(FgCamera.up, local.cameraUp, sizeof(FgCamera.up));
+    std::memcpy(FgCamera.right, local.cameraRight, sizeof(FgCamera.right));
+    std::memcpy(FgCamera.forward, local.cameraForward, sizeof(FgCamera.forward));
+    FgCamera.hostFlags = local.flags; FgCamera.hostWidth = local.width; FgCamera.hostHeight = local.height;
+    FgCamera.hostGeneration = local.generation; FgCamera.hostFrameId = local.frameId; FgCamera.hostQpc = local.qpc;
+    FgCamera.sceneColorId = local.sceneColorId; FgCamera.sceneDepthId = local.sceneDepthId;
+    FgCamera.worldDraws = local.worldDraws; FgCamera.nearDraws = local.nearDraws;
+    FgCamera.hostDeltaMilliseconds = local.deltaMilliseconds; FgCamera.hostMetersPerUnit = local.metersPerUnit;
+    FgCamera.hostVkDevice = local.vkDevice; FgCamera.hostDepthImage = local.depthImage;
