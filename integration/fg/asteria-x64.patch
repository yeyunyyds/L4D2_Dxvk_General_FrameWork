+    const uint32_t required = ASTERIA_HOST_FRAME_MAIN_VIEW | ASTERIA_HOST_FRAME_SCENE_DEPTH |
+        ASTERIA_HOST_FRAME_CAMERA | ASTERIA_HOST_FRAME_GPU_INPUTS;
+    bool finite = std::isfinite(local.deltaMilliseconds) && local.deltaMilliseconds > 0.0f && local.deltaMilliseconds <= 1000.0f &&
+        std::isfinite(local.cameraNear) && local.cameraNear > 0.0f && std::isfinite(local.cameraFar) && local.cameraFar > local.cameraNear &&
+        std::isfinite(local.cameraVerticalFov) && local.cameraVerticalFov > 0.0f && local.cameraVerticalFov < 3.14159265f &&
+        std::isfinite(local.metersPerUnit) && local.metersPerUnit > 0.0f;
+    for (const float value : local.cameraPosition) finite = finite && std::isfinite(value);
+    for (const float value : local.cameraUp) finite = finite && std::isfinite(value);
+    for (const float value : local.cameraRight) finite = finite && std::isfinite(value);
+    for (const float value : local.cameraForward) finite = finite && std::isfinite(value);
+    if (local.reserved || (local.flags & required) != required || !local.generation || !local.frameId ||
+        !local.qpc || !local.sceneColorId || !local.sceneDepthId || !local.width || !local.height ||
+        local.width > 4096 || local.height > 4096 || !local.worldDraws ||
+        !local.vkDevice || !local.depthImage || !local.motionImage ||
+        local.depthFormat != VK_FORMAT_R32_SFLOAT ||
+        local.motionFormat != VK_FORMAT_R32G32_SFLOAT ||
+        local.depthLayout != VK_IMAGE_LAYOUT_SHADER_READ_ONLY_OPTIMAL ||
+        local.motionLayout != VK_IMAGE_LAYOUT_SHADER_READ_ONLY_OPTIMAL || !finite)
+    {
