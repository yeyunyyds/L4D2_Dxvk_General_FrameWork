+extern "C" int32_t __stdcall AsteriaQueryFrameInputConsumerV1(
+    AsteriaFrameInputConsumerV1 *consumer)
+{
+    if (!consumer || consumer->struct_size != sizeof(*consumer) ||
+        consumer->api_version != ASTERIA_FG_CONSUMER_API_V1 || !consumer->device)
+        return ASTERIA_FG_INPUT_INVALID_ARGUMENT;
+    const std::lock_guard<std::mutex> lock(StateMutex);
+    for (const auto &entry : FgSwapchains)
+    {
+        const auto &swapchain = entry.second;
+        if (!swapchain || asteria_vk::Bits(swapchain->device) != consumer->device)
+            continue;
+        consumer->graphics_family = swapchain->graphicsFamily;
+        consumer->async_compute_family = swapchain->asyncComputeFamily;
+        consumer->flags = swapchain->asyncWorkloadsEnabled ? 1u : 0u;
+        consumer->reserved = 0;
+        return ASTERIA_FG_INPUT_OK;
+    }
+    return ASTERIA_FG_INPUT_UNAVAILABLE;
+}
