+static bool ResolveFgQueuesForSurface(VkPhysicalDevice physical, VkSurfaceKHR surface,
+                                      asteria_fg_runtime::FgDeviceQueues &queues)
+{
+    if (!physical || !surface || !queues.gameQueue) return false;
+    const auto unused = [&](VkQueue queue) {
+        return queue && queue != queues.gameQueue && queue != queues.presentQueue &&
+            queue != queues.asyncComputeQueue && queue != queues.imageAcquireQueue;
+    };
+    // WSI support is surface-specific.  Prefer a non-game queue and keep all
+    // four FFX roles physically distinct.
+    for (const auto &candidate : queues.candidates)
+    {
+        VkBool32 supported = VK_FALSE;
+        if (candidate.queue == queues.gameQueue ||
+            vkGetPhysicalDeviceSurfaceSupportKHR(physical, candidate.family, surface, &supported) != VK_SUCCESS ||
+            !supported) continue;
+        queues.presentQueue = candidate.queue;
+        queues.presentFamily = candidate.family;
+        break;
+    }
+    if (!queues.presentQueue) return false;
+    for (const auto &candidate : queues.candidates)
+    {
+        if (unused(candidate.queue) && (candidate.flags & VK_QUEUE_COMPUTE_BIT))
+        {
+            queues.asyncComputeQueue = candidate.queue;
+            queues.asyncComputeFamily = candidate.family;
+            break;
+        }
+    }
+    for (const auto &candidate : queues.candidates)
+    {
+        if (unused(candidate.queue))
+        {
+            queues.imageAcquireQueue = candidate.queue;
+            queues.imageAcquireFamily = candidate.family;
+            break;
+        }
+    }
+    return queues.asyncComputeQueue != VK_NULL_HANDLE && queues.imageAcquireQueue != VK_NULL_HANDLE;
+}
