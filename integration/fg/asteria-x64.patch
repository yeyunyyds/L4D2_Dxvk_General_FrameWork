+inline void ReadCompletedContentProbe(FgSwapchainState &state, uint64_t frameID)
+{
+    if (!state.contentProbeMap) return;
+    const uint32_t slot = uint32_t(frameID % state.contentProbeFrameIds.size());
+    if (state.contentProbeFrameIds[slot] != frameID) return;
+    const uint8_t *bytes = state.contentProbeMap + slot * FgSwapchainState::ContentProbeFrameBytes;
+    const uint8_t *source = bytes;
+    const uint8_t *generated = bytes + FgSwapchainState::ContentProbeSamples * 4;
+    uint64_t different = 0, absoluteDifference = 0;
+    for (uint32_t sample = 0; sample < FgSwapchainState::ContentProbeSamples; ++sample)
+    {
+        uint32_t pixelDifference = 0;
+        for (uint32_t channel = 0; channel < 3; ++channel)
+        {
+            const uint8_t a = source[sample * 4 + channel];
+            const uint8_t b = generated[sample * 4 + channel];
+            pixelDifference += a > b ? a - b : b - a;
+        }
+        absoluteDifference += pixelDifference;
+        if (pixelDifference > 3) ++different;
+    }
+    state.contentProbeFrames.fetch_add(1, std::memory_order_relaxed);
+    state.contentProbePixels.fetch_add(FgSwapchainState::ContentProbeSamples, std::memory_order_relaxed);
+    state.contentProbeDifferentPixels.fetch_add(different, std::memory_order_relaxed);
+    state.contentProbeAbsoluteDifference.fetch_add(absoluteDifference, std::memory_order_relaxed);
+    if (different) state.contentProbeDifferentFrames.fetch_add(1, std::memory_order_relaxed);
+    state.contentProbeFrameIds[slot] = UINT64_MAX;
+}
+
+inline void RetireCompletedFrameInputs(FgSwapchainState &state, bool guaranteeFreeSlot)
+{
+    while (!state.retiredInputs.empty())
+    {
+        auto &oldest = state.retiredInputs.front();
+        if (WaitForInputCompletion(state, oldest.interpolationCompletionValue, 0))
+        {
+            ReadCompletedContentProbe(state, oldest.input->frameID);
+            state.retiredInputs.pop_front();
+            state.retirePollReleases.fetch_add(1, std::memory_order_relaxed);
+            continue;
+        }
+        // The Host owns three rotating input slots.  Once two old leases are
+        // retained alongside the pending/current frame, wait only for the
+        // oldest interpolation submission so the next Host frame always has
+        // a free slot.  This replaces the previous all-queue/device-idle wait.
+        if (!guaranteeFreeSlot || state.retiredInputs.size() < 2) break;
+        const auto start = std::chrono::steady_clock::now();
+        const bool completed = WaitForInputCompletion(
+            state, oldest.interpolationCompletionValue, UINT64_MAX);
+        state.retireWaitNanoseconds.fetch_add(ElapsedNanoseconds(start), std::memory_order_relaxed);
+        state.retireForcedWaits.fetch_add(1, std::memory_order_relaxed);
+        if (!completed) break;
+        ReadCompletedContentProbe(state, oldest.input->frameID);
+        state.retiredInputs.pop_front();
+    }
+}
