+inline bool AllocateContentProbe(FgSwapchainState &state)
+{
+    VkBufferCreateInfo info{VK_STRUCTURE_TYPE_BUFFER_CREATE_INFO};
+    info.size = FgSwapchainState::ContentProbeFrameBytes * state.contentProbeFrameIds.size();
+    info.usage = VK_BUFFER_USAGE_TRANSFER_DST_BIT;
+    info.sharingMode = VK_SHARING_MODE_EXCLUSIVE;
+    if (vkCreateBuffer(state.device, &info, nullptr, &state.contentProbeBuffer) != VK_SUCCESS)
+        return false;
+    VkMemoryRequirements requirements{};
+    vkGetBufferMemoryRequirements(state.device, state.contentProbeBuffer, &requirements);
+    VkPhysicalDeviceMemoryProperties properties{};
+    vkGetPhysicalDeviceMemoryProperties(state.physicalDevice, &properties);
+    uint32_t memoryIndex = UINT32_MAX;
+    for (uint32_t index = 0; index < properties.memoryTypeCount; ++index)
+    {
+        const auto flags = properties.memoryTypes[index].propertyFlags;
+        if ((requirements.memoryTypeBits & (1u << index)) &&
+            (flags & (VK_MEMORY_PROPERTY_HOST_VISIBLE_BIT | VK_MEMORY_PROPERTY_HOST_COHERENT_BIT)) ==
+                (VK_MEMORY_PROPERTY_HOST_VISIBLE_BIT | VK_MEMORY_PROPERTY_HOST_COHERENT_BIT))
+        {
+            memoryIndex = index;
+            break;
+        }
+    }
+    if (memoryIndex == UINT32_MAX) return false;
+    VkMemoryAllocateInfo allocation{VK_STRUCTURE_TYPE_MEMORY_ALLOCATE_INFO};
+    allocation.allocationSize = requirements.size;
+    allocation.memoryTypeIndex = memoryIndex;
+    if (vkAllocateMemory(state.device, &allocation, nullptr, &state.contentProbeMemory) != VK_SUCCESS ||
+        vkBindBufferMemory(state.device, state.contentProbeBuffer, state.contentProbeMemory, 0) != VK_SUCCESS ||
+        vkMapMemory(state.device, state.contentProbeMemory, 0, VK_WHOLE_SIZE, 0,
+                    reinterpret_cast<void **>(&state.contentProbeMap)) != VK_SUCCESS)
+        return false;
+    std::memset(state.contentProbeMap, 0, size_t(info.size));
+    return true;
+}
+
+inline void DestroyContentProbe(FgSwapchainState &state)
+{
+    if (state.contentProbeMap && state.contentProbeMemory)
+        vkUnmapMemory(state.device, state.contentProbeMemory);
+    state.contentProbeMap = nullptr;
+    if (state.contentProbeBuffer)
+        vkDestroyBuffer(state.device, state.contentProbeBuffer, nullptr);
+    if (state.contentProbeMemory)
+        vkFreeMemory(state.device, state.contentProbeMemory, nullptr);
+    state.contentProbeBuffer = VK_NULL_HANDLE;
+    state.contentProbeMemory = VK_NULL_HANDLE;
+}
