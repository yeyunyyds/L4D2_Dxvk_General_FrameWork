+static bool CopyHostFrameInput(const AsteriaHostFrameV2 *frame, AsteriaHostFrameV2 *outCopy)
+{
+    __try
+    {
+        if (!frame || frame->structSize != sizeof(AsteriaHostFrameV2) ||
+            frame->apiVersion != ASTERIA_HOST_FRAME_API_VERSION_2)
+            return false;
+        *outCopy = *frame;
+        return true;
+    }
+    __except (EXCEPTION_EXECUTE_HANDLER)
+    {
+        return false;
+    }
+}
+
+extern "C" int32_t __stdcall AsteriaSubmitHostFrameV2(const AsteriaHostFrameV2 *frame)
+{
+    AsteriaHostFrameV2 local{};
+    if (!CopyHostFrameInput(frame, &local)) return -1;
+    const std::lock_guard<std::mutex> lock(FgCamera.mutex);
+    ++FgCamera.hostSubmitted;
+    const uint32_t required = ASTERIA_HOST_FRAME_MAIN_VIEW | ASTERIA_HOST_FRAME_SCENE_DEPTH |
+        ASTERIA_HOST_FRAME_CAMERA | ASTERIA_HOST_FRAME_GPU_INPUTS;
+    bool finite = std::isfinite(local.deltaMilliseconds) && local.deltaMilliseconds > 0.0f && local.deltaMilliseconds <= 1000.0f &&
+        std::isfinite(local.cameraNear) && local.cameraNear > 0.0f && std::isfinite(local.cameraFar) && local.cameraFar > local.cameraNear &&
+        std::isfinite(local.cameraVerticalFov) && local.cameraVerticalFov > 0.0f && local.cameraVerticalFov < 3.14159265f &&
+        std::isfinite(local.metersPerUnit) && local.metersPerUnit > 0.0f;
+    for (const float value : local.cameraPosition) finite = finite && std::isfinite(value);
+    for (const float value : local.cameraUp) finite = finite && std::isfinite(value);
+    for (const float value : local.cameraRight) finite = finite && std::isfinite(value);
+    for (const float value : local.cameraForward) finite = finite && std::isfinite(value);
+    if (local.reserved || (local.flags & required) != required || !local.generation || !local.frameId ||
+        !local.qpc || !local.sceneColorId || !local.sceneDepthId || !local.width || !local.height ||
+        local.width > 4096 || local.height > 4096 || !local.worldDraws ||
+        !local.vkDevice || !local.depthImage || !local.motionImage ||
+        local.depthFormat != VK_FORMAT_R32_SFLOAT ||
+        local.motionFormat != VK_FORMAT_R32G32_SFLOAT ||
+        local.depthLayout != VK_IMAGE_LAYOUT_SHADER_READ_ONLY_OPTIMAL ||
+        local.motionLayout != VK_IMAGE_LAYOUT_SHADER_READ_ONLY_OPTIMAL || !finite)
+    {
+        ++FgCamera.hostRejected;
+        return -1;
+    }
+    if (local.generation < FgCamera.hostGeneration ||
+        (local.generation == FgCamera.hostGeneration && local.frameId <= FgCamera.hostFrameId))
+    {
+        ++FgCamera.hostRejected;
+        return -3;
+    }
+    FgCamera.valid = true; FgCamera.inGame = true;
+    FgCamera.reset = (local.flags & ASTERIA_HOST_FRAME_HISTORY_RESET) != 0;
+    FgCamera.nearPlane = local.cameraNear; FgCamera.farPlane = local.cameraFar;
+    FgCamera.fovVerticalRadians = local.cameraVerticalFov;
+    std::memcpy(FgCamera.position, local.cameraPosition, sizeof(FgCamera.position));
+    std::memcpy(FgCamera.up, local.cameraUp, sizeof(FgCamera.up));
+    std::memcpy(FgCamera.right, local.cameraRight, sizeof(FgCamera.right));
+    std::memcpy(FgCamera.forward, local.cameraForward, sizeof(FgCamera.forward));
+    FgCamera.hostFlags = local.flags; FgCamera.hostWidth = local.width; FgCamera.hostHeight = local.height;
+    FgCamera.hostGeneration = local.generation; FgCamera.hostFrameId = local.frameId; FgCamera.hostQpc = local.qpc;
+    FgCamera.sceneColorId = local.sceneColorId; FgCamera.sceneDepthId = local.sceneDepthId;
+    FgCamera.worldDraws = local.worldDraws; FgCamera.nearDraws = local.nearDraws;
+    FgCamera.hostDeltaMilliseconds = local.deltaMilliseconds; FgCamera.hostMetersPerUnit = local.metersPerUnit;
+    FgCamera.hostVkDevice = local.vkDevice; FgCamera.hostDepthImage = local.depthImage;
+    FgCamera.hostMotionImage = local.motionImage; FgCamera.hostDepthFormat = local.depthFormat;
+    FgCamera.hostMotionFormat = local.motionFormat; FgCamera.hostDepthLayout = local.depthLayout;
+    FgCamera.hostMotionLayout = local.motionLayout;
+    ++FgCamera.hostAccepted; ++FgCamera.sampleCount;
+    return 0;
+}
