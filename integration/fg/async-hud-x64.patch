+inline void DestroyHudComposite(FgSwapchainState &state)
+{
+    const std::lock_guard<std::mutex> lock(state.hudCompositeMutex);
+    for (auto &binding : state.hudBindings)
+    {
+        if (binding.uiView) vkDestroyImageView(state.device, binding.uiView, nullptr);
+        if (binding.outputView) vkDestroyImageView(state.device, binding.outputView, nullptr);
+    }
+    state.hudBindings.clear();
+    if (state.hudDescriptorPool) vkDestroyDescriptorPool(state.device, state.hudDescriptorPool, nullptr);
+    if (state.hudPipeline) vkDestroyPipeline(state.device, state.hudPipeline, nullptr);
+    if (state.hudPipelineLayout) vkDestroyPipelineLayout(state.device, state.hudPipelineLayout, nullptr);
+    if (state.hudDescriptorSetLayout) vkDestroyDescriptorSetLayout(state.device, state.hudDescriptorSetLayout, nullptr);
+    state.hudDescriptorPool = VK_NULL_HANDLE;
+    state.hudPipeline = VK_NULL_HANDLE;
+    state.hudPipelineLayout = VK_NULL_HANDLE;
+    state.hudDescriptorSetLayout = VK_NULL_HANDLE;
+}
+
+inline bool InitializeHudComposite(FgSwapchainState &state)
+{
+    VkDescriptorSetLayoutBinding bindings[2]{};
+    bindings[0].binding = 0;
+    bindings[0].descriptorType = VK_DESCRIPTOR_TYPE_SAMPLED_IMAGE;
+    bindings[0].descriptorCount = 1;
+    bindings[0].stageFlags = VK_SHADER_STAGE_COMPUTE_BIT;
+    bindings[1].binding = 1;
+    bindings[1].descriptorType = VK_DESCRIPTOR_TYPE_STORAGE_IMAGE;
+    bindings[1].descriptorCount = 1;
+    bindings[1].stageFlags = VK_SHADER_STAGE_COMPUTE_BIT;
+    VkDescriptorSetLayoutCreateInfo setInfo{VK_STRUCTURE_TYPE_DESCRIPTOR_SET_LAYOUT_CREATE_INFO};
+    setInfo.bindingCount = 2;
+    setInfo.pBindings = bindings;
+    if (vkCreateDescriptorSetLayout(state.device, &setInfo, nullptr,
+                                    &state.hudDescriptorSetLayout) != VK_SUCCESS) return false;
+
+    VkPipelineLayoutCreateInfo layoutInfo{VK_STRUCTURE_TYPE_PIPELINE_LAYOUT_CREATE_INFO};
+    layoutInfo.setLayoutCount = 1;
+    layoutInfo.pSetLayouts = &state.hudDescriptorSetLayout;
+    if (vkCreatePipelineLayout(state.device, &layoutInfo, nullptr,
+                               &state.hudPipelineLayout) != VK_SUCCESS)
+    {
+        DestroyHudComposite(state);
+        return false;
+    }
+
+    // Debug mode affects GENERATED frames only: the exact same 3x3 protected
+    // overlay is composed after FSR, with protected output pixels painted white.
+    wchar_t maskDebugValue[8]{};
+    const DWORD maskDebugLength = GetEnvironmentVariableW(
+        L"LDB_FG_MASK_DEBUG_WHITE", maskDebugValue, 8);
+    const bool maskDebugWhite = maskDebugLength == 1 && maskDebugValue[0] == L'1';
+    VkShaderModuleCreateInfo shaderInfo{VK_STRUCTURE_TYPE_SHADER_MODULE_CREATE_INFO};
+    shaderInfo.codeSize = maskDebugWhite ? sizeof(HudCompositeWhiteSpirv)
+                                         : HudCompositeSpirvSize;
+    shaderInfo.pCode = maskDebugWhite ? HudCompositeWhiteSpirv.data()
+                                      : HudCompositeSpirv;
+    VkShaderModule shader = VK_NULL_HANDLE;
+    if (vkCreateShaderModule(state.device, &shaderInfo, nullptr, &shader) != VK_SUCCESS)
+    {
+        DestroyHudComposite(state);
+        return false;
+    }
+    VkComputePipelineCreateInfo pipelineInfo{VK_STRUCTURE_TYPE_COMPUTE_PIPELINE_CREATE_INFO};
+    pipelineInfo.stage = {VK_STRUCTURE_TYPE_PIPELINE_SHADER_STAGE_CREATE_INFO};
+    pipelineInfo.stage.stage = VK_SHADER_STAGE_COMPUTE_BIT;
+    pipelineInfo.stage.module = shader;
+    pipelineInfo.stage.pName = "main";
+    pipelineInfo.layout = state.hudPipelineLayout;
+    const VkResult pipelineResult = vkCreateComputePipelines(
+        state.device, VK_NULL_HANDLE, 1, &pipelineInfo, nullptr, &state.hudPipeline);
+    vkDestroyShaderModule(state.device, shader, nullptr);
+    if (pipelineResult != VK_SUCCESS)
+    {
+        DestroyHudComposite(state);
+        return false;
+    }
+
+    VkDescriptorPoolSize poolSizes[2]{};
+    poolSizes[0] = {VK_DESCRIPTOR_TYPE_SAMPLED_IMAGE, 16};
+    poolSizes[1] = {VK_DESCRIPTOR_TYPE_STORAGE_IMAGE, 16};
+    VkDescriptorPoolCreateInfo poolInfo{VK_STRUCTURE_TYPE_DESCRIPTOR_POOL_CREATE_INFO};
+    poolInfo.maxSets = 16;
+    poolInfo.poolSizeCount = 2;
+    poolInfo.pPoolSizes = poolSizes;
+    if (vkCreateDescriptorPool(state.device, &poolInfo, nullptr,
+                               &state.hudDescriptorPool) != VK_SUCCESS)
+    {
+        DestroyHudComposite(state);
+        return false;
+    }
+    return true;
+}
+
+inline VkDescriptorSet HudCompositeDescriptorSet(
+    FgSwapchainState &state, const FfxResource &uiResource,
+    const FfxResource &outputResource)
+{
+    const VkImage uiImage = asteria_vk::Decode<VkImage>(
+        uiResource.resource, state.device, asteria_vk::HandleKind::Image);
+    const VkImage outputImage = asteria_vk::Decode<VkImage>(
+        outputResource.resource, state.device, asteria_vk::HandleKind::Image);
+    if (!uiImage || !outputImage) return VK_NULL_HANDLE;
+    const std::lock_guard<std::mutex> lock(state.hudCompositeMutex);
+    for (const auto &binding : state.hudBindings)
+        if (binding.uiImage == uiImage && binding.outputImage == outputImage)
+            return binding.descriptorSet;
+    if (state.hudBindings.size() >= 16) return VK_NULL_HANDLE;
+
+    FgSwapchainState::HudCompositeBinding binding{};
+    binding.uiImage = uiImage;
+    binding.outputImage = outputImage;
+    const auto makeView = [&](VkImage image, VkFormat format, VkImageView &view) {
+        VkImageViewCreateInfo info{VK_STRUCTURE_TYPE_IMAGE_VIEW_CREATE_INFO};
+        info.image = image;
+        info.viewType = VK_IMAGE_VIEW_TYPE_2D;
+        info.format = format;
+        info.components = {VK_COMPONENT_SWIZZLE_IDENTITY, VK_COMPONENT_SWIZZLE_IDENTITY,
+                           VK_COMPONENT_SWIZZLE_IDENTITY, VK_COMPONENT_SWIZZLE_IDENTITY};
+        info.subresourceRange = {VK_IMAGE_ASPECT_COLOR_BIT, 0, 1, 0, 1};
+        return vkCreateImageView(state.device, &info, nullptr, &view) == VK_SUCCESS;
+    };
+    if (!makeView(uiImage, ToVkFormat(uiResource.description.format), binding.uiView) ||
+        !makeView(outputImage, ToVkFormat(outputResource.description.format), binding.outputView))
+    {
+        if (binding.uiView) vkDestroyImageView(state.device, binding.uiView, nullptr);
+        if (binding.outputView) vkDestroyImageView(state.device, binding.outputView, nullptr);
+        return VK_NULL_HANDLE;
+    }
+    VkDescriptorSetAllocateInfo allocate{VK_STRUCTURE_TYPE_DESCRIPTOR_SET_ALLOCATE_INFO};
+    allocate.descriptorPool = state.hudDescriptorPool;
+    allocate.descriptorSetCount = 1;
+    allocate.pSetLayouts = &state.hudDescriptorSetLayout;
+    if (vkAllocateDescriptorSets(state.device, &allocate, &binding.descriptorSet) != VK_SUCCESS)
+    {
+        vkDestroyImageView(state.device, binding.uiView, nullptr);
+        vkDestroyImageView(state.device, binding.outputView, nullptr);
+        return VK_NULL_HANDLE;
+    }
+    VkDescriptorImageInfo images[2]{};
+    images[0].imageView = binding.uiView;
+    images[0].imageLayout = VK_IMAGE_LAYOUT_SHADER_READ_ONLY_OPTIMAL;
+    images[1].imageView = binding.outputView;
+    images[1].imageLayout = VK_IMAGE_LAYOUT_GENERAL;
+    VkWriteDescriptorSet writes[2]{};
+    for (uint32_t index = 0; index < 2; ++index)
+    {
+        writes[index].sType = VK_STRUCTURE_TYPE_WRITE_DESCRIPTOR_SET;
+        writes[index].dstSet = binding.descriptorSet;
+        writes[index].dstBinding = index;
+        writes[index].descriptorCount = 1;
+        writes[index].descriptorType = index == 0 ? VK_DESCRIPTOR_TYPE_SAMPLED_IMAGE : VK_DESCRIPTOR_TYPE_STORAGE_IMAGE;
+        writes[index].pImageInfo = &images[index];
+    }
+    vkUpdateDescriptorSets(state.device, 2, writes, 0, nullptr);
+    state.hudBindings.push_back(binding);
+    return binding.descriptorSet;
+}
+
+inline bool RecordHudComposite(FgSwapchainState &state, VkCommandBuffer commandBuffer,
+                               const FfxResource &uiResource,
+                               const FfxResource &outputResource)
+{
+    if (!state.hudPipeline || !commandBuffer) return false;
+    const VkDescriptorSet descriptors = HudCompositeDescriptorSet(state, uiResource, outputResource);
+    const VkImage output = asteria_vk::Decode<VkImage>(
+        outputResource.resource, state.device, asteria_vk::HandleKind::Image);
+    if (!descriptors || !output) return false;
+    VkImageMemoryBarrier before{VK_STRUCTURE_TYPE_IMAGE_MEMORY_BARRIER};
+    before.srcAccessMask = VK_ACCESS_SHADER_WRITE_BIT;
+    before.dstAccessMask = VK_ACCESS_SHADER_WRITE_BIT;
+    before.oldLayout = before.newLayout = VK_IMAGE_LAYOUT_GENERAL;
+    before.srcQueueFamilyIndex = before.dstQueueFamilyIndex = VK_QUEUE_FAMILY_IGNORED;
+    before.image = output;
+    before.subresourceRange = {VK_IMAGE_ASPECT_COLOR_BIT, 0, 1, 0, 1};
+    vkCmdPipelineBarrier(commandBuffer, VK_PIPELINE_STAGE_COMPUTE_SHADER_BIT,
+                         VK_PIPELINE_STAGE_COMPUTE_SHADER_BIT, 0,
+                         0, nullptr, 0, nullptr, 1, &before);
+    vkCmdBindPipeline(commandBuffer, VK_PIPELINE_BIND_POINT_COMPUTE, state.hudPipeline);
+    vkCmdBindDescriptorSets(commandBuffer, VK_PIPELINE_BIND_POINT_COMPUTE,
+                            state.hudPipelineLayout, 0, 1, &descriptors, 0, nullptr);
+    vkCmdDispatch(commandBuffer, (state.width + 7) / 8, (state.height + 7) / 8, 1);
+    VkImageMemoryBarrier after = before;
+    after.srcAccessMask = VK_ACCESS_SHADER_WRITE_BIT;
+    after.dstAccessMask = VK_ACCESS_MEMORY_READ_BIT | VK_ACCESS_TRANSFER_READ_BIT;
+    vkCmdPipelineBarrier(commandBuffer, VK_PIPELINE_STAGE_COMPUTE_SHADER_BIT,
+                         VK_PIPELINE_STAGE_ALL_COMMANDS_BIT, 0,
+                         0, nullptr, 0, nullptr, 1, &after);
+    state.hudCompositeDispatches.fetch_add(1, std::memory_order_relaxed);
+    return true;
+}
