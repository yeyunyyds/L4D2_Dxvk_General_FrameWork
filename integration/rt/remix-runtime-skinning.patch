     ++m_skinningCommands;
+    // Keep the dedicated skinning queue bounded on drivers that become
+    // unstable when a dense animated scene records one very large command
+    // list. Queue submission order preserves the skin-to-BLAS dependency.
+    constexpr uint32_t kSkinningCommandsPerSubmission = 16;
+    if (m_skinningCommands >= kSkinningCommandsPerSubmission) {
+      m_skinningContext->flushCommandList();
+      m_skinningCommands = 0;
+    }
   }

