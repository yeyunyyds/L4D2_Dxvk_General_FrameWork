+void AssetReplacer::updateExternalMesh(remixapi_MeshHandle handle, std::vector<RasterGeometry>&& submeshes) {
+  auto found = m_extMeshes.find(handle);
+  if (found == m_extMeshes.end()) {
+    // LDB's persistent update entry point is an upsert.  Using it for the
+    // first frame as well as later frames lets the runtime assign stable
+    // topology identity before the mesh is ever registered.
+    m_extMeshes.emplace(handle, std::make_unique<std::vector<RasterGeometry>>(std::move(submeshes)));
+    return;
+  }
+
+  *found->second = std::move(submeshes);
+}
