+void AssetReplacer::updateExternalMesh(remixapi_MeshHandle handle, std::vector<RasterGeometry>&& submeshes) {
+  auto found = m_extMeshes.find(handle);
+  if (found == m_extMeshes.end()) {
+    Logger::err("Ignoring update for an unknown external mesh (handle=" + tostr(handle) + ") ");
+    return;
+  }
+
+  *found->second = std::move(submeshes);
+}
