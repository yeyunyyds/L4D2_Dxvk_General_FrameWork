   return E_NOINTERFACE;
@@ -148,2 +156,22 @@ HRESULT Direct3DDevice9Ex_LSS<EnableSync>::QueryInterface(REFIID riid, LPVOID* p

+template<bool EnableSync>
+HRESULT Direct3DDevice9Ex_LSS<EnableSync>::submitRtPacket(const void* bytes, uint32_t size, bool hello, uint32_t* commandUid) try {
+  BRIDGE_DEVICE_LOCKGUARD();
+  if (!gbBridgeRunning.load(std::memory_order_acquire)) { return D3DERR_DEVICELOST; }
+  uint32_t uid = 0;
+  {
+    ClientMessage c(hello ? Commands::LdbRt_Hello : Commands::LdbRt_Metadata, getId());
+    uid = static_cast<uint32_t>(c.get_uid());
+    c.send_data(size);
+    c.send_data(size, bytes);
+    if (!RESULT_SUCCESS(c.finish())) { return D3DERR_DEVICELOST; }
+  }
+  *commandUid = uid;
+  if (!hello) { return S_OK; }
+  WAIT_FOR_SERVER_RESPONSE("LdbRt_Hello", D3DERR_DEVICELOST, uid);
+  const HRESULT result = static_cast<HRESULT>(DeviceBridge::get_data());
+  DeviceBridge::pop_front();
+  return result;
+} catch (const BridgeReadFailure&) { return D3DERR_DEVICELOST; }
+
 template<bool EnableSync>
